<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.agentic-spring-ai</groupId>
        <artifactId>agentic-spring-ai-extensions</artifactId>
        <version>${revision}</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>agentic-spring-ai-sandbox</artifactId>

    <name>Agentic Spring AI Sandbox</name>
    <description>Built in sandbox tools for Agentic Spring AI Extensions</description>
    <url>https://github.com/agentic-spring-ai/agentic-spring-ai-extensions</url>
    <scm>
        <connection>git://github.com/agentic-spring-ai/agentic-spring-ai-extensions.git</connection>
        <developerConnection>git@github.com:agentic-spring-ai/agentic-spring-ai-extensions.git</developerConnection>
        <url>https://github.com/agentic-spring-ai/agentic-spring-ai-extensions</url>
    </scm>

    <properties>
        <agentscope-runtime.version>1.0.2</agentscope-runtime.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-runtime-sandbox-core</artifactId>
            <version>${agentscope-runtime.version}</version>
        </dependency>

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <dependency>
            <groupId>io.github.agentic-spring-ai</groupId>
            <artifactId>agentic-spring-ai-graph-core</artifactId>
            <version>${agentic-spring-ai.version}</version>
        </dependency>

        <dependency>
            <groupId>io.github.agentic-spring-ai</groupId>
            <artifactId>agentic-spring-ai-starter-dashscope</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>io.github.agentic-spring-ai</groupId>
            <artifactId>agentic-spring-ai-agent-framework</artifactId>
            <version>${agentic-spring-ai.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
